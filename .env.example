# GROQ_API_KEY: Primary API key for Groq AI briefings (moonshotai/kimi-k2-instruct, openai/gpt-oss-120b).
# Configure this via the Secrets panel in the AI Studio UI.
GROQ_API_KEY="MY_GROQ_API_KEY"

# GEMINI_API_KEY: Optional fallback key for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
